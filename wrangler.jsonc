{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "masalife-holding",
  // Answer only on the custom domain. The workers.dev URL and the
  // per-version preview URLs are outside Cloudflare Access; left unset, every
  // `wrangler deploy` turned them back on and undid the dashboard setting
  // (found 2026-09-25, following the 2026-09-22 workers.dev audit finding).
  "workers_dev": false,
  "preview_urls": false,
  "compatibility_date": "2026-06-03",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "."
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
